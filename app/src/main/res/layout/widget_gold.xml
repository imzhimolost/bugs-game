<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:background="@drawable/bg_gold_ball"
    android:gravity="center"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="ЦБ ЗОЛОТО"
        android:textColor="#5D4037"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetGoldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWidgetTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Загрузка..."
        android:textColor="#3E2723"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWidgetGoldPrice"
        android:layout_centerHorizontal="true"
        android:text="руб/грамм"
        android:textColor="#5D4037"
        android:textSize="9sp" />
</RelativeLayout>